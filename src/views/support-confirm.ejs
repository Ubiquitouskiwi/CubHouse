<%- include('partials/header') %>

<section class="card auth-card" aria-labelledby="confirm-title">
  <h1 id="confirm-title"><%= action.label %>: <%= account.displayName %></h1>
  <ul>
    <li><strong>Account:</strong> <%= account.displayName %> (<%= account.roleLabel %>), <%= account.maskedEmail %></li>
    <li><strong>Sign-in:</strong> <%= account.locked ? 'locked' : 'not locked' %>, <%= account.failedAttempts %> failed attempt(s)</li>
    <li><strong>Two-step verification:</strong> <%= account.mfaEnabled ? 'on' : 'off' %></li>
  </ul>
  <p><strong>What this does:</strong> <%= action.effect %></p>
  <p class="muted">
    <%= account.displayName %> and the guardians are emailed, they see a notice
    at the next sign-in, and it is recorded in the family's audit trail under
    your name.
  </p>
  <% if (error) { %>
    <div class="alert alert-error" role="alert"><p><%= error %></p></div>
  <% } %>
  <form method="post" action="/support/accounts/<%= account.id %>/<%= actionKey %>" class="stacked-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>
      Type <strong><%= action.word %></strong> to confirm
      <input type="text" name="confirm" autocomplete="off" autocapitalize="characters" spellcheck="false" required autofocus />
    </label>
    <label>
      Authenticator code (a new one, not a recovery code)
      <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required />
    </label>
    <button type="submit" class="primary-button"><%= action.label %></button>
    <a class="ghost-button" href="/support">Cancel</a>
  </form>
</section>

<%- include('partials/footer') %>
