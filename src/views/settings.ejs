<%- include('partials/header') %>

<section class="card">
  <h1>Settings</h1>
  <p class="muted">Manage your account, sign-in, appearance, and your data.</p>
  <dl class="profile-details">
    <dt>Account ID</dt>
    <dd class="account-id"><code><%= user.id %></code></dd>
    <dt>Role</dt>
    <dd><%= roleLabel || user.role %></dd>
    <dt>Two-step verification</dt>
    <dd><%= user.mfaEnabled ? 'On' : 'Off' %> (<a href="/settings/security">manage</a>)</dd>
  </dl>
</section>

<section class="card">
  <h2>Profile</h2>
  <form class="stacked-form" method="post" action="/settings/profile">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>
      Display name
      <input type="text" name="displayName" value="<%= user.displayName %>" maxlength="80" required />
    </label>
    <label>
      Username
      <%# A display handle, not the sign-in name (sign-in uses the email), so
          password managers are told to leave it alone. %>
      <input type="text" name="username" value="<%= user.username || '' %>" autocomplete="nickname"
        data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
        placeholder="optional, 3 to 32 characters" pattern="[a-zA-Z0-9_.\-]{3,32}" />
    </label>
    <label>
      Email
      <input type="email" name="email" value="<%= user.email %>" autocomplete="email" required />
    </label>
    <label>
      Current password (only needed to change your email)
      <input type="password" name="currentPassword" autocomplete="current-password" />
    </label>
    <button type="submit" class="primary-button">Save profile</button>
  </form>
</section>

<section class="card" id="password">
  <h2>Change password</h2>
  <p class="muted">At least 12 characters. A short sentence works well. Changing it signs out your other devices.</p>
  <form class="stacked-form" method="post" action="/settings/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <%- include('partials/autofill-username', { email: user.email }) %>
    <label>
      Current password
      <input type="password" name="currentPassword" autocomplete="current-password" required />
    </label>
    <label>
      New password
      <input type="password" name="newPassword" autocomplete="new-password" minlength="12" required />
    </label>
    <label>
      Confirm new password
      <input type="password" name="confirmPassword" autocomplete="new-password" minlength="12" required />
    </label>
    <button type="submit" class="primary-button">Update password</button>
  </form>
</section>

<section class="card">
  <h2>Appearance</h2>
  <form class="stacked-form" method="post" action="/settings/theme">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <fieldset class="theme-options">
      <legend class="sr-only">Theme preference</legend>
      <% themes.forEach(function (option) { %>
        <label class="theme-option">
          <input type="radio" name="theme" value="<%= option %>" <%= (user.theme || 'system') === option ? 'checked' : '' %> />
          <span class="theme-option-label">
            <% if (option === 'light') { %>Light<% } %>
            <% if (option === 'dark') { %>Dark<% } %>
            <% if (option === 'system') { %>System default<% } %>
          </span>
        </label>
      <% }); %>
    </fieldset>
    <button type="submit" class="primary-button">Save appearance</button>
  </form>
</section>

<% if (user.role !== 'operator') { %>
<section class="card">
  <h2>Your data</h2>
  <p class="muted">Download a copy of everything this site holds about you: your account, comments, reactions, albums, and download history.</p>
  <form method="post" action="/settings/export">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <button type="submit" class="ghost-button">Export my data</button>
  </form>
</section>

<% } %>

<% if (user.role !== 'parent' && user.role !== 'operator') { %>
<section class="card danger-zone">
  <h2>Delete account</h2>
  <p class="muted">
    This permanently deletes your account and personal albums, and signs you
    out everywhere. Photos you downloaded stay on your devices; please delete
    them too.
  </p>
  <form class="stacked-form" method="post" action="/settings/delete-account"
    data-confirm="Permanently delete your account? This cannot be undone.">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <fieldset>
      <legend>Your comments</legend>
      <label class="checkbox-row"><input type="radio" name="contentMode" value="anonymize" checked /> Keep them, shown as "Former member"</label>
      <label class="checkbox-row"><input type="radio" name="contentMode" value="delete" /> Delete them</label>
    </fieldset>
    <label>
      Type DELETE to confirm
      <input type="text" name="confirm" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore
        data-form-type="other" required />
    </label>
    <%- include('partials/autofill-username', { email: user.email }) %>
    <label>
      Password
      <input type="password" name="password" autocomplete="current-password" required />
    </label>
    <button type="submit" class="btn-danger">Delete my account</button>
  </form>
</section>
<% } %>

<%- include('partials/footer') %>
