<%- include('partials/header') %>

<section class="card auth-card">
  <h1>Confirm it is you</h1>
  <p class="muted">
    This change affects who can see or keep the photos, so we ask you to
    confirm your identity first. You will not be asked again for a few minutes.
  </p>
  <% if (error) { %>
    <div class="alert alert-error" role="alert"><p><%= error %></p></div>
  <% } %>
  <form method="post" action="/reauth" class="stacked-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <%- include('partials/autofill-username', { email: accountEmail }) %>
    <label>
      Password
      <input type="password" name="password" autocomplete="current-password" required autofocus />
    </label>
    <% if (needsCode) { %>
      <label>
        6-digit code from your authenticator app
        <input type="text" name="code" inputmode="numeric" pattern="[0-9 ]*" autocomplete="one-time-code"
          autocapitalize="off" spellcheck="false" maxlength="7" required />
      </label>
    <% } %>
    <button type="submit" class="primary-button">Confirm</button>
  </form>
</section>

<%- include('partials/footer') %>
