<%- include('partials/header') %>

<section class="card auth-card">
  <h1>Sign In</h1>
  <p class="muted">Welcome back. Enter your details to view the gallery.</p>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error" role="alert"><p><%= error %></p></div>
  <% } %>
  <form method="post" action="/login" class="stacked-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>
      Email
      <input type="email" name="email" autocomplete="username" required />
    </label>
    <label>
      Password
      <input type="password" name="password" autocomplete="current-password" required />
    </label>
    <button type="submit" class="primary-button">Sign In</button>
  </form>
  <p class="muted">
    Forgot your password or lost your phone?
    <a href="/reset">Use a reset code from a parent</a>.
  </p>
  <p class="muted">
    Have an access code from the family?
    <a href="/register">Create an account</a>.
  </p>
</section>

<%- include('partials/footer') %>
