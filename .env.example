# Copy to .env and fill in. Development runs with zero cost and no secrets
# (in-memory store, local encrypted media under data/media, console
# notifications). Production refuses to start until the REQUIRED values below
# are set (see src/security/bootstrapChecks.js).

# --- Site identity (shown to family; keep real names OUT of the repository) ---
# APP_NAME=Cubhouse          # page titles, emails, authenticator label
# APP_SLUG=family-photos          # cookies, file names, logs, backups (a-z 0-9 -)
# APP_DOMAIN=photos.example.com   # used by deploy/Caddyfile
# APP_FOOTER_TEXT=Our little family den. Please keep access codes and photos between us.

# --- Server ---
PORT=3000
NODE_ENV=development
# Loopback only. In production Caddy terminates TLS in front of the app.
# The container image sets HOST=0.0.0.0 and APP_IN_CONTAINER=true itself; it
# must then be published to 127.0.0.1 only (docker run -p 127.0.0.1:PORT:3000).
HOST=127.0.0.1
# Number of reverse proxies in front of the app (Caddy on the same host = 1).
# REQUIRED in production. Never trust X-Forwarded-For beyond this count.
# TRUST_PROXY_HOPS=1
# PUBLIC_ORIGIN=https://photos.example.com

# --- Secrets (REQUIRED in production) ---
# openssl rand -base64 48
# SESSION_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
# Wraps the media data key and encrypts MFA secrets. Losing it makes every
# stored photo unreadable: keep an offline copy with the guardians.
# APP_ENCRYPTION_KEY=

# --- Data store (REQUIRED in production) ---
# Postgres also holds sessions and shared rate limits (see deploy/sql).
# DATABASE_URL=postgres://photos_app:password@host:25060/photos?sslmode=verify-full
# PGSSLROOTCERT=/etc/family-photos/do-ca-certificate.crt

# --- Media storage ---
# local (development) or spaces (production; a PRIVATE bucket, see deploy/SPACES.md)
# MEDIA_BACKEND=spaces
# DO_SPACES_ENDPOINT=REGION.digitaloceanspaces.com
# DO_SPACES_REGION=us-east-1
# DO_SPACES_BUCKET=
# DO_SPACES_KEY=
# DO_SPACES_SECRET=

# --- First guardian (created only into an empty store) ---
SEED_ADMIN_EMAIL=parent@example.com
# Production: set a strong one-time password; it must be changed at first sign-in.
# SEED_ADMIN_PASSWORD=

# --- Development-only test accounts (ignored in production) ---
# npm run dev turns these on. Dev and user accounts plus generated sample photos.
# SEED_TEST_ACCOUNTS=true
# SEED_DEV_EMAIL=dev@example.com
# SEED_USER_EMAIL=user@example.com

# --- Guardian notifications ---
# console (dev) | smtp (production). The SMTP provider needs a DPA.
# NOTIFY_TRANSPORT=smtp
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# NOTIFY_FROM=Cubhouse <no-reply@example.com>   # From header; default "APP_NAME <no-reply@localhost>"

# --- Policy knobs (defaults are the recommended values) ---
# PARENT_MFA_REQUIRED=true            # default true in production
# GOVERNANCE_SOLO_DELAY_MS=86400000   # 24h in production, 0 in development
# ACCESS_CODE_TTL_MS=259200000        # 72 hours
# DOWNLOAD_RETENTION_DAYS=90
# AUDIT_DETAIL_RETENTION_DAYS=365
# LEDGER_STORE_USER_AGENT=false
# BREACHED_PASSWORD_CHECK=true        # default true in production
# SESSION_IDLE_TIMEOUT_MS=900000      # 15 minutes
# SESSION_ABSOLUTE_LIFETIME_MS=604800000
# UPLOAD_MAX_BYTES=15728640
# LOG_LEVEL=info

# --- Backups and operator alerts (production; see deploy/SPACES.md, docs/RUNBOOK.md) ---
# BACKUP_BUCKET=                       # a SEPARATE private, versioned bucket
# AGE_RECIPIENTS_FILE=/etc/family-photos/backup-recipients.txt   # guardians' age PUBLIC keys
# MEDIA_S3CMD_CONFIG=/etc/family-photos/s3cfg-media-readonly
# BACKUP_S3CMD_CONFIG=/etc/family-photos/s3cfg-backup
# BACKUP_RETENTION_DAYS=30
# ALERT_EMAIL=you@example.org           # who gets backup and startup alerts
