# Host-only settings for the backup and alert units on a StarlingTek host.
# Copy to /etc/family-photos/host.env (root:family-photos-backup, mode 0640).
# The app container never sees these; its settings come from `stk env`.
# Values: no quotes, no backslashes (systemd and docker parse those differently).

# The database CA certificate, host path (the container uses /data/...).
PGSSLROOTCERT=/etc/family-photos/do-ca-certificate.crt

# A SEPARATE private, versioned bucket (deploy/SPACES.md, "Backup bucket").
BACKUP_BUCKET=
# The guardians' age PUBLIC keys, one per line.
AGE_RECIPIENTS_FILE=/etc/family-photos/backup-recipients.txt
# Read-only key for the media bucket; read/write key for the backup bucket only.
MEDIA_S3CMD_CONFIG=/etc/family-photos/s3cfg-media-readonly
BACKUP_S3CMD_CONFIG=/etc/family-photos/s3cfg-backup
BACKUP_RETENTION_DAYS=30

# Who gets backup and backup-check failure emails (comma-separated).
ALERT_EMAIL=you@example.org
