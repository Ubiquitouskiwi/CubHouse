{
  "name": "cubhouse",
  "version": "0.1.0",
  "private": true,
  "description": "Private, invite-only family photo sharing you host yourself.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "SEED_TEST_ACCOUNTS=true node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm test && npm run test:pg && npm run audit:prod",
    "test:pg": "node scripts/test-pg.js",
    "check:names": "node scripts/check-forbidden-names.js --tree --messages",
    "hooks:install": "git config core.hooksPath scripts/hooks"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "bcryptjs": "2.4.3",
    "busboy": "1.6.0",
    "connect-flash": "0.1.1",
    "connect-pg-simple": "10.0.0",
    "csrf-sync": "4.2.1",
    "dotenv": "16.4.5",
    "ejs": "3.1.10",
    "express": "4.22.3",
    "express-rate-limit": "8.7.3",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0"
  },
  "license": "AGPL-3.0-only"
}
